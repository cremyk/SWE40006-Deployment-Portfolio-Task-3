@page
@model IndexModel
@{
    ViewData["Title"] = "Inventory Management System";
}

<div class="container mt-3">
    <!-- Header Banner -->
    <div class="p-4 mb-4 bg-light rounded-3 border">
        <div class="container-fluid">
            <h2 class="display-6 fw-bold text-primary">Inventory and Stock Management System</h2>
            <p class="col-md-10 fs-6 text-muted mb-0">SWE40006  — Task 3.2 (C# Web App)</p>
        </div>
    </div>

    <!-- Metric Summary Cards -->
    <div class="row g-3 mb-4 text-center">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm p-3">
                <h5>Total SKUs</h5>
                <h3 class="fw-bold">@Model.Items.Count</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm p-3">
                <h5>Total Valuation</h5>
                <h3 class="fw-bold">RM @Model.TotalValue.ToString("F2")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm p-3">
                <h5>Low Stock Alerts</h5>
                <h3 class="fw-bold">@Model.LowStockCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm p-3">
                <h5>Out of Stock</h5>
                <h3 class="fw-bold">@Model.OutOfStockCount</h3>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Stock Records Table -->
        <div class="col-lg-8">
            <div class="card shadow-sm p-3 mb-4">
                <h4 class="mb-3">Current Stock Inventory</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>SKU</th>
                                <th>Product Name</th>
                                <th>Category</th>
                                <th>Unit Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th class="text-center">Quick Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><code>@item.Sku</code></td>
                                    <td><strong>@item.Name</strong></td>
                                    <td><span class="badge bg-secondary">@item.Category</span></td>
                                    <td>RM @item.UnitPrice.ToString("F2")</td>
                                    <td class="fw-bold">@item.StockQuantity</td>
                                    <td>
                                        @if (item.IsOutOfStock)
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                        else if (item.IsLowStock)
                                        {
                                            <span class="badge bg-warning text-dark">Low Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">In Stock</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <form method="post" asp-page-handler="Restock" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="amount" value="5" />
                                                <button type="submit" class="btn btn-outline-success">+5 Restock</button>
                                            </form>
                                            <form method="post" asp-page-handler="Decrease" class="d-inline ms-1">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-outline-danger" @(item.IsOutOfStock ? "disabled" : "")>-1 Sell</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Item Form -->
        <div class="col-lg-4">
            <div class="card shadow-sm p-3 mb-4">
                <h4 class="mb-3">Register New Item</h4>
                <form method="post" asp-page-handler="AddItem">
                    <div class="mb-2">
                        <label class="form-label">Item Name</label>
                        <input asp-for="NewItem.Name" class="form-control" placeholder="e.g. Wireless Headset" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Category</label>
                        <select asp-for="NewItem.Category" class="form-select" required>
                            <option value="">Select Category</option>
                            <option value="Electronics">Electronics</option>
                            <option value="Furniture">Furniture</option>
                            <option value="Stationery">Stationery</option>
                            <option value="Hardware">Hardware</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Unit Price (RM)</label>
                        <input asp-for="NewItem.UnitPrice" type="number" step="0.01" class="form-control" placeholder="e.g. 120.00" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Initial Stock</label>
                        <input asp-for="NewItem.StockQuantity" type="number" class="form-control" placeholder="e.g. 15" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reorder Alert Threshold</label>
                        <input asp-for="NewItem.ReorderThreshold" type="number" class="form-control" value="10" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Add Item to Inventory</button>
                </form>
            </div>
        </div>
    </div>
</div>